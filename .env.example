# ============================================
# SOA-CLI Configuration Template
# ============================================
# Copy this file to .env and customize the values
# The .env file is gitignored and contains your local configuration

# ============================================
# LLM Configuration
# ============================================

# LLM Model to use (leave empty for default Qwen model)
# Examples: "qwen-coder", "qwen-32b", etc.
LLM_MODEL=

# Temperature for text generation (0.0 = deterministic, 1.0 = creative)
# Recommended: 0.2-0.5 for academic writing
LLM_TEMPERATURE=0.3

# Timeout for LLM API calls in seconds
# Increase if you experience timeouts with longer papers
LLM_TIMEOUT=300

# ============================================
# Pipeline Configuration
# ============================================

# Maximum number of parallel workers for concurrent processing
# Adjust based on your CPU cores (recommended: 4-12)
MAX_WORKERS=10

# Maximum characters to extract from PDFs
# ~30000 chars = 15-20 pages (includes abstract, intro, methods, results)
# Increase if papers are short, decrease if timeout occurs
MAX_PDF_CHARS=30000

# Number of clusters for similarity-based paper clustering
# Recommended: 4-8 for <50 papers, 6-12 for 50-100 papers
CLUSTER_COUNT=6

# ============================================
# Optional: Advanced Settings
# ============================================

# Uncomment and configure if needed

# Maximum retries for failed LLM calls
# MAX_RETRIES=3

# Enable debug logging (true/false)
# DEBUG=false

# Custom papers directory (default: ./papers)
# PAPERS_DIR=./papers

# Custom artifacts directory (default: ./artifacts)
# ARTIFACTS_DIR=./artifacts
