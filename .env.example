# ============================================
# SOA-SDK Configuration Template
# ============================================
# Copy this file to .env and customize the values
# The .env file is gitignored and contains your local configuration

# ============================================
# LLM Provider Configuration
# ============================================

# Default Provider (used if not specified in code/CLI)
# Options: openai, claude, gemini, deepseek, qwen, glm, ollama
LLM_PROVIDER=qwen

# Default Model (provider-specific)
# Examples:
#   OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo
#   Claude: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
#   Gemini: gemini-pro, gemini-1.5-pro
#   DeepSeek: deepseek-chat, deepseek-coder
#   Qwen: qwen-turbo, qwen-plus, qwen-max
#   GLM: glm-4, glm-3-turbo
#   Ollama: llama2, mistral, codellama
LLM_MODEL=qwen-turbo

# ============================================
# API Key
# ============================================
# Single API key used for the selected LLM provider
# The system will use this key based on your LLM_PROVIDER setting
#
# Examples:
#   OpenAI: sk-...
#   Anthropic: sk-ant-...
#   Google: AIza...
#   DeepSeek: sk-...
#   Qwen: sk-... (or leave empty to use local Qwen CLI)
#   GLM: ...
#   Ollama: (not needed - runs locally)
API_KEY=

# Ollama (for local models)
# URL to Ollama API (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Timeout for LLM API calls in seconds
# Increase if you experience timeouts with longer papers or slower APIs
LLM_TIMEOUT=300

# ============================================
# Pipeline Configuration
# ============================================

# Maximum number of parallel workers for concurrent processing
# Adjust based on your CPU cores (recommended: 4-12)
MAX_WORKERS=10

# Maximum characters to extract from PDFs
# ~30000 chars = 15-20 pages (includes abstract, intro, methods, results)
# When truncation needed, prioritizes: Abstract > Intro > Methods > Results > Conclusion
# De-prioritizes: Acknowledgements, References, Appendices
# Console warnings displayed when papers are truncated
# Increase to retain more content, decrease to reduce LLM costs
MAX_PDF_CHARS=30000

# Number of clusters for similarity-based paper clustering
# Leave unset or comment out to auto-detect optimal clusters using silhouette analysis
# Set manually to override (e.g., CLUSTER_COUNT=6)
# CLUSTER_COUNT=6

# ============================================
# Optional: Advanced Settings
# ============================================

# Uncomment and configure if needed

# Maximum retries for failed LLM calls
# MAX_RETRIES=3

# Citation style for references (ieee, apa, chicago, harvard)
# IEEE: Numerical [1], [2] with abbreviated names
# APA: Author-date (Smith, 2020) with full names
# Chicago: Author-date (Smith 2020) with full names
# Harvard: Author-date (Smith 2020) with initials
CITATION_STYLE=ieee

# Logging Configuration
# Log level for console output (DEBUG, INFO, WARNING, ERROR)
# DEBUG: Detailed information for debugging
# INFO: General pipeline progress (default, recommended)
# WARNING: Only warnings and errors
# ERROR: Only errors
LOG_LEVEL=INFO

# Enable debug logging (true/false)
# DEBUG=false

# Custom papers directory (default: ./papers)
# PAPERS_DIR=./papers

# Custom artifacts directory (default: ./artifacts)
# ARTIFACTS_DIR=./artifacts
