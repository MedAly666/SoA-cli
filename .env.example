# ============================================
# SOA-CLI Configuration Template
# ============================================
# Copy this file to .env and customize the values
# The .env file is gitignored and contains your local configuration

# ============================================
# LLM Configuration
# ============================================

# LLM Provider - Choose your CLI tool
# Supported providers: claude, gemini, qwen, gpt, glm
# Each must have the corresponding CLI binary installed and in PATH.
#
# Installation:
#   claude: Install Claude CLI from Anthropic
#   gemini: Install Gemini CLI from Google
#   qwen: Install Qwen CLI (recommended for getting started)
#   gpt: Install OpenAI GPT CLI
#   glm: Install GLM CLI from Zhipu AI
#
# The CLI binary name must match the provider name (e.g., 'qwen' -> 'qwen' command)
LLM_PROVIDER=qwen

# LLM Model - Specific model for the chosen provider
# Leave empty to use the provider's default model.
#
# Examples by provider:
#   Qwen:    "qwen-coder", "qwen-32b", "qwen3.5-32b" (or empty for default)
#   Claude:  "claude-sonnet-4.5", "claude-opus-4", "claude-haiku-4"
#   Gemini:  "gemini-3-pro", "gemini-2.5-flash", "gemini-ultra-2"
#   GPT:     "gpt-5.2", "gpt-4.5-turbo", "o1-mini"
#   GLM:     "glm-5", "glm-4-plus"
#
# Check your CLI documentation for available models:
#   qwen --help
#   claude --help
#   etc.
LLM_MODEL=

# Temperature for text generation (0.0 = deterministic, 1.0 = creative)
# Recommended: 0.2-0.5 for academic writing
# Note: Some providers may not support temperature control
LLM_TEMPERATURE=0.3

# Timeout for LLM API calls in seconds
# Default: 120 seconds
# For large synthesis/writing tasks, you may need 300-600 seconds.
# Increase this if you see timeout errors during writer or synthesis stages.
LLM_TIMEOUT=120

# Citation Style
# Supported styles: ieee (default), apa, chicago, harvard
# Controls how citations are formatted in the State of the Art document.
#   ieee: Numeric citations [1], [2], etc.
#   apa: Author-date (Author, Year)
#   chicago: Author-date with full names
#   harvard: Author-date with surnames only
CITATION_STYLE=ieee

# ============================================
# Pipeline Configuration
# ============================================

# Maximum number of parallel workers for concurrent processing
# Adjust based on your CPU cores (recommended: 4-12)
MAX_WORKERS=10

# Maximum characters to extract from PDFs
# ~30000 chars = 15-20 pages (includes abstract, intro, methods, results)
# Increase if papers are short, decrease if timeout occurs
MAX_PDF_CHARS=30000

# Number of clusters for similarity-based paper clustering
# Recommended: 4-8 for <50 papers, 6-12 for 50-100 papers
CLUSTER_COUNT=6

# ============================================
# Semantic PDF Parsing (Enhanced Extraction)
# ============================================

# Use semantic PDF parser to extract figures, tables, and structure
# When enabled, PDFs are parsed into sections with embedded figures/tables
# preserving context and relationships (60-80% more information vs plain text)
# Default: true (recommended for technical papers)
USE_SEMANTIC_PDF=true

# Extract and store figure images from PDFs
# When disabled, only figure captions are kept (still better than plain text)
# Default: false (set to true if you plan to use vision LLM for figures)
EXTRACT_PDF_IMAGES=false

# Include figures in LLM input (as text descriptions/captions)
# Default: true (highly recommended)
INCLUDE_FIGURES_IN_TEXT=true

# Include tables in LLM input (as markdown tables)
# Default: true (highly recommended)
INCLUDE_TABLES_IN_TEXT=true

# ============================================
# Optional: Advanced Settings
# ============================================

# Uncomment and configure if needed

# Maximum retries for failed LLM calls
# MAX_RETRIES=3

# Enable debug logging (true/false)
# DEBUG=false

# Custom papers directory (default: ./papers)
# PAPERS_DIR=./papers

# Custom artifacts directory (default: ./artifacts)
# ARTIFACTS_DIR=./artifacts
# ============================================
# Paper Fetcher Configuration (PRISMA)
# ============================================

# Data sources for paper search (comma-separated)
# Supported: semantic_scholar, arxiv, dblp
# Default: semantic_scholar,arxiv
PAPER_SOURCES=semantic_scholar,arxiv

# Maximum number of papers to fetch per query
# Recommendation: 50-100 for focused reviews, 100-200 for comprehensive surveys
# Default: 50
PAPER_MAX_RESULTS=50

# Minimum publication year for papers
# Papers older than this year will be excluded
# Default: 2015 (last 10 years)
PAPER_MIN_YEAR=2015

# Minimum citation count for established papers
# Papers published before current year - 1 with fewer citations are excluded
# Very recent papers (last year) bypass this filter
# Default: 10
PAPER_MIN_CITATIONS=10

# Require venue whitelist matching
# When true, only papers from whitelisted conferences/journals are included
# Venues are defined in config/venues.json
# Default: true (recommended to avoid predatory publishers)
PAPER_REQUIRE_WHITELIST=true

# Maximum papers to screen with LLM at once
# Larger batches are faster but may hit rate limits
# Default: 50
PAPER_SCREENING_BATCH_SIZE=50