# ============================================
# SOA-CLI Configuration Template
# ============================================
# Copy this file to .env and customize the values
# The .env file is gitignored and contains your local configuration

# ============================================
# LLM Configuration
# ============================================

# LLM Provider - Choose your CLI tool
# Supported providers: claude, gemini, qwen, gpt, glm
# Each must have the corresponding CLI binary installed and in PATH.
#
# Installation:
#   claude: Install Claude CLI from Anthropic
#   gemini: Install Gemini CLI from Google
#   qwen: Install Qwen CLI (recommended for getting started)
#   gpt: Install OpenAI GPT CLI
#   glm: Install GLM CLI from Zhipu AI
#
# The CLI binary name must match the provider name (e.g., 'qwen' -> 'qwen' command)
LLM_PROVIDER=qwen

# LLM Model - Specific model for the chosen provider
# Leave empty to use the provider's default model.
#
# Examples by provider:
#   Qwen:    "qwen-coder", "qwen-32b", "qwen3.5-32b" (or empty for default)
#   Claude:  "claude-sonnet-4.5", "claude-opus-4", "claude-haiku-4"
#   Gemini:  "gemini-3-pro", "gemini-2.5-flash", "gemini-ultra-2"
#   GPT:     "gpt-5.2", "gpt-4.5-turbo", "o1-mini"
#   GLM:     "glm-5", "glm-4-plus"
#
# Check your CLI documentation for available models:
#   qwen --help
#   claude --help
#   etc.
LLM_MODEL=

# Temperature for text generation (0.0 = deterministic, 1.0 = creative)
# Recommended: 0.2-0.5 for academic writing
# Note: Some providers may not support temperature control
LLM_TEMPERATURE=0.3

# Timeout for LLM API calls in seconds
# Default: 120 seconds
# For large synthesis/writing tasks, you may need 300-600 seconds.
# Increase this if you see timeout errors during writer or synthesis stages.
LLM_TIMEOUT=120

# Citation Style
# Supported styles: ieee (default), apa, chicago, harvard
# Controls how citations are formatted in the State of the Art document.
#   ieee: Numeric citations [1], [2], etc.
#   apa: Author-date (Author, Year)
#   chicago: Author-date with full names
#   harvard: Author-date with surnames only
CITATION_STYLE=ieee

# ============================================
# Pipeline Configuration
# ============================================

# Maximum number of parallel workers for concurrent processing
# Adjust based on your CPU cores (recommended: 4-12)
MAX_WORKERS=10

# Maximum characters to extract from PDFs
# ~30000 chars = 15-20 pages (includes abstract, intro, methods, results)
# Increase if papers are short, decrease if timeout occurs
MAX_PDF_CHARS=30000

# Number of clusters for similarity-based paper clustering
# Recommended: 4-8 for <50 papers, 6-12 for 50-100 papers
CLUSTER_COUNT=6

# ============================================
# Optional: Advanced Settings
# ============================================

# Uncomment and configure if needed

# Maximum retries for failed LLM calls
# MAX_RETRIES=3

# Enable debug logging (true/false)
# DEBUG=false

# Custom papers directory (default: ./papers)
# PAPERS_DIR=./papers

# Custom artifacts directory (default: ./artifacts)
# ARTIFACTS_DIR=./artifacts
